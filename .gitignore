# Python
.venv/
venv/
__pycache__/
*.pyc
.gradio/
*.log
.DS_Store

# Data: the 1,000-image gallery and its metadata ship with the repo (~22 MiB),
# so a clone runs without Kaggle. The feature cache and any local copies stay out.
data/*
!data/gallery/
!data/metadata.csv
*.zip

# CLIP feature cache
**/image_features.pt
*.npy

# The failure figure ships with the repo; anything else rendered locally does not.
evaluation/montages/*
!evaluation/montages/failureCases.png

# Labelling sheet is generated on demand (python main.py label-sheet)
evaluation/sets/labelSheet.html

# Secrets — tokens live in ~/.kaggle, never in the repo
kaggle.json
access_token
.env
